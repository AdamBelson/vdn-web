{% set attributes = create_attribute({class: ['fr-follow']}) %}

<div{{ attributes }}>
  <div class="fr-container">
    <div class="fr-grid-row">
      {% if newsletter %}
      <div class="fr-col-12{% if newsletter and social %} fr-col-md-8{% endif %}">
        <div class="fr-follow__newsletter">
            {{ newsletter }}
        </div>
      </div>
      {% endif %}
      {% if social %}
      <div class="fr-col-12{% if newsletter and social %} fr-col-md-4{% endif %}">
        <div class="fr-follow__social">
          {{ social }}
        </div>
      </div>
      {% endif %}
    </div>
  </div>
</div>
