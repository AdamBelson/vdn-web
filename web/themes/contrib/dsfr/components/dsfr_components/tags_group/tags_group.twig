{% if tags %}
  {% set html_id = html_id|default('fr-tags-group--' ~ random()) %}
  {% set attributes = create_attribute({
    id: html_id,
    class: ['fr-tags-group'],
  }) %}
  <ul{{ attributes }}>
    {% set tags = tags and tags is not sequence ? [tags] : tags %}
    {% for tag in tags %}
      <li>{{ tag }}</li>
    {% endfor %}
  </ul>
{% endif %}
