    'highlight',
    'input',
    'link',
    'logo',
    'modal',
    'navigation',
    'notice',
    'pagination',
    'password',
    'quote',
    'radio',
    'search',
    'segmented',
    'select',
    'share',
    'sidemenu',
    'skiplink',
    'stepper',
    'summary',
    'tab',
    'table',
    'tag',
    'tile',
    'toggle',
    'tooltip',
    'transcription',
    'translate',
    'upload',
    'utility',
  ];
}

/**
 * Gets data from this configuration object.
 *
 * @param string $setting_name
 *   A string that maps to a key within the configuration data.
 *   For instance in the following configuration array:
 *   @code
 *   [
 *     'foo' => [
 *       'bar' => 'baz',
 *     ],
 *   ];
 *   @endcode
 *   A key of 'foo.bar' would return the string 'baz'. However, a key of 'foo'
 *   would return ['bar' => 'baz'].
 *   If no key is specified, then the entire data array is returned.
 * @param string|null $theme
 *   The theme name.
 *
 * @return mixed
 *   The data that was requested.
 */
function _dsfr_theme_get_setting(string $setting_name, ?string $theme = NULL): mixed {
  return DeprecationHelper::backwardsCompatibleCall(
    currentVersion: \Drupal::VERSION,
    deprecatedVersion: '11.3',
    currentCallable: fn() => \Drupal::service(ThemeSettingsProvider::class)->getSetting($setting_name, $theme),
    deprecatedCallable: fn() => theme_get_setting($setting_name, $theme),
  );
}
