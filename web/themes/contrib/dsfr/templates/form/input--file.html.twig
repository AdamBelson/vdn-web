{#
/**
 * @file
 * Theme override for an 'input' #type form element.
 *
 * Available variables:
 * - attributes: A list of HTML attributes for the input element.
 * - children: Optional additional rendered elements.
 *
 * @see template_preprocess_input()
 */
#}
{% set classes = [
  'fr-upload',
] %}
{% if theme.code.w3c != 1 %}
  <input{{ attributes.addClass(classes).setAttribute('aria-describedby', attributes.id ~ '-messages') }}> {{ children }}
{% else %}
  <input{{ attributes.addClass(classes).removeAttribute('aria-required', 'autocorrect') }}> {{ children }}
{% endif %}
